# Database (PostgreSQL — lihat docs/SETUP-DATABASE.md untuk Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth (NextAuth — email + password)
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# Seed accounts (npm run db:seed)
SEED_ADMIN_EMAIL="admin@undangandigital.com"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_USER_EMAIL="user@undangandigital.com"
SEED_USER_PASSWORD="User123!"

# Email (Resend) — optional untuk MVP
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Undangan Digital <noreply@undangandigital.com>"

# File storage — pick ONE approach:
#
# A) Local disk (default on Laragon / VPS — no credit card, no cloud)
#    Photos save to public/uploads/ and are served at /uploads/...
#    Leave R2 vars as placeholders or remove them. Optional:
# ALLOW_LOCAL_MEDIA_UPLOAD="true"
#
# B) Cloudflare R2 (production at scale — needs Cloudflare account + card)
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_BUCKET_NAME="undangan-media"
# R2_PUBLIC_URL="https://media.undangandigital.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Undangan Digital"
