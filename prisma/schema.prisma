generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  passwordHash  String?
  role          UserRole      @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  invitations   Invitation[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id             String        @id @default(cuid())
  slug           String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Couple info
  groomName      String
  brideName      String
  groomFullName  String?
  brideFullName  String?
  groomParents   String?
  brideParents   String?

  // Template & design
  templateId     String        @default("javanese-classic")
  primaryColor   String        @default("#8B5E3C")
  accentColor    String        @default("#D4AF37")
  fontFamily     String        @default("playfair")
  coverPhotoUrl  String?

  // Music
  musicUrl       String?
  musicTitle     String?
  musicAutoplay  Boolean       @default(true)

  // Story
  loveStory      String?

  // Capacity
  seatQuota      Int?          // Max total tamu hadir (kosong = tanpa batas)

  // Status
  isPublished    Boolean       @default(false)
  publishedAt    DateTime?
  opensAt        DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  events         WeddingEvent[]
  guests         Guest[]
  wishes         Wish[]
  photos         Photo[]
  openLogs       OpenLog[]
}

model WeddingEvent {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  name         String     // e.g. "Akad Nikah", "Resepsi", "Siraman"
  nameEn       String?    // English label
  date         DateTime
  endTime      DateTime?
  venue        String
  address      String
  mapsUrl      String?
  wazeUrl      String?
  dresscode    String?
  notes        String?
  order        Int        @default(0)

  rsvps        RSVP[]
}

model Guest {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  name           String
  phone          String?
  email          String?
  reservedSeats  Int        @default(1) // Kuota kursi untuk nama ini di daftar tamu
  token          String     @unique @default(cuid())
  isVip          Boolean    @default(false)
  tableNumber  String?
  notes        String?

  rsvps        RSVP[]
  openLogs     OpenLog[]

  createdAt    DateTime   @default(now())
}

model RSVP {
  id           String       @id @default(cuid())
  guestId      String
  guest        Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  eventId      String
  event        WeddingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status       RSVPStatus   @default(PENDING)
  pax          Int          @default(1)
  mealPref     String?
  message      String?

  respondedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([guestId, eventId])
}

model Wish {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  guestName    String
  message      String
  isApproved   Boolean    @default(true)
  isHidden     Boolean    @default(false)
  emoji        String?

  createdAt    DateTime   @default(now())
}

model Photo {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  url          String
  caption      String?
  order        Int        @default(0)
  uploadedBy   String?    // "couple" or guest name

  createdAt    DateTime   @default(now())
}

model OpenLog {
  id           String     @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id])
  guestId      String?
  guest        Guest?     @relation(fields: [guestId], references: [id])

  openedAt     DateTime   @default(now())
  userAgent    String?
  ip           String?
}

enum RSVPStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
}
